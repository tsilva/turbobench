{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "turbobench.benchmark-proof/v1",
  "type": "object",
  "required": [
    "schema",
    "proof_id",
    "bindings",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "turbobench.benchmark-proof/v1"
    },
    "proof_id": {
      "type": "string"
    },
    "bindings": {
      "type": "object",
      "required": [
        "request_id",
        "policy_id",
        "benchmark_machine",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "benchmark_machine": {
          "type": "object"
        },
        "mode": {
          "type": "string",
          "enum": [
            "smoke",
            "full"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    }
  }
}
